# API
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nexusflow:nexusflow@localhost:5432/nexusflow

# OpenClaw (M2)
OPENCLAW_WS_URL=wss://47.250.122.37/
OPENCLAW_BASIC_USER=
OPENCLAW_BASIC_PASS=
OPENCLAW_GATEWAY_TOKEN=
# At least one gateway auth credential is required in deployment:
# - preferred: OPENCLAW_GATEWAY_TOKEN
# - fallback compatibility: OPENCLAW_BASIC_PASS (used as connect.auth.password)
OPENCLAW_REQUEST_SCOPES=operator.admin
OPENCLAW_AGENT_ID=main
OPENCLAW_AGENT_SESSION_KEY=agent:main:main
OPENCLAW_AGENT_ID_RETRIEVAL=search-retrieval
OPENCLAW_AGENT_ID_CLARIFY=search-clarify
OPENCLAW_AGENT_ID_EXECUTION=ticket-execution
# Multi-agent topology is the default contract.
# These values can be overridden, but they must remain unique and reachable.
OPENCLAW_AGENT_ID_ROUTER=support-router
OPENCLAW_AGENT_ID_EVIDENCE_PLANNER=support-evidence-planner
OPENCLAW_AGENT_ID_PLANNER=support-planner
OPENCLAW_AGENT_ID_SUPPORT_EVIDENCE_SELECTOR=support-evidence-selector
OPENCLAW_AGENT_ID_API_SPECIALIST=support-api-specialist
OPENCLAW_AGENT_ID_HOWTO_SPECIALIST=support-howto-specialist
OPENCLAW_AGENT_ID_BEHAVIOR_SPECIALIST=support-behavior-specialist
OPENCLAW_AGENT_ID_TROUBLESHOOTING_SPECIALIST=support-troubleshooting-specialist
OPENCLAW_AGENT_ID_EVIDENCE_JUDGE=support-evidence-judge
OPENCLAW_AGENT_ID_SUPPORT_CITATION_BINDER=
OPENCLAW_AGENT_ID_CITATION_CURATOR=support-citation-curator
OPENCLAW_AGENT_ID_SUPPORT_CITATION_SELECTOR=support-citation-selector
OPENCLAW_AGENT_ID_ANSWER_COMPOSER=support-answer-composer
OPENCLAW_AGENT_MODEL_ROUTER=
OPENCLAW_AGENT_MODEL_EVIDENCE_PLANNER=
OPENCLAW_AGENT_MODEL_PLANNER=
OPENCLAW_AGENT_MODEL_SUPPORT_EVIDENCE_SELECTOR=
OPENCLAW_AGENT_MODEL_API_SPECIALIST=
OPENCLAW_AGENT_MODEL_HOWTO_SPECIALIST=
OPENCLAW_AGENT_MODEL_BEHAVIOR_SPECIALIST=
OPENCLAW_AGENT_MODEL_TROUBLESHOOTING_SPECIALIST=
OPENCLAW_AGENT_MODEL_EVIDENCE_JUDGE=
OPENCLAW_AGENT_MODEL_SUPPORT_CITATION_BINDER=
OPENCLAW_AGENT_MODEL_CITATION_CURATOR=
OPENCLAW_AGENT_MODEL_SUPPORT_CITATION_SELECTOR=
OPENCLAW_AGENT_MODEL_ANSWER_COMPOSER=
OPENCLAW_AGENT_SESSION_PREFIX=nf
OPENCLAW_ALLOW_SELF_SIGNED=false
OPENCLAW_SEARCH_INDEX=public_kb
OPENCLAW_CONNECT_TIMEOUT_MS=10000
OPENCLAW_METHOD_TIMEOUT_MS=30000
OPENCLAW_SEARCH_TIMEOUT_MS=12000
OPENCLAW_MAX_RETRIES=2
OPENCLAW_CIRCUIT_BREAKER_THRESHOLD=5
OPENCLAW_SEARCH_TOP_K=5
OPENCLAW_DEEP_SEARCH_MAX_ROUNDS=3
AI_SEARCH_ANSWER_CONFIDENCE_THRESHOLD=0.62
AGENT_RESOLUTION_CONFIDENCE_THRESHOLD=0.76
FEATURE_KB_GROUNDED_SEARCH=true
FEATURE_QUICK_TICKET=true
FEATURE_DEEP_RETRIEVAL=true
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MULTIMODAL_MODEL=gpt-5.4
# Optional: fallback to a local Codex OAuth profile when OPENAI_API_KEY is empty
OPENAI_CODEX_AUTH_PROFILE_PATH=
OPENAI_MULTIMODAL_MAX_IMAGES=4

# GitHub Repo Knowledge Base (read-only)
GITHUB_KB_ENABLED=false
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN_READONLY=
GITHUB_WEBHOOK_SECRET=
GITHUB_KB_BOOTSTRAP_REPO_URL=
GITHUB_KB_BOOTSTRAP_BRANCH=main
GITHUB_KB_BOOTSTRAP_INCLUDE_PATHS=AGENTS.md,README.md,CONTRIBUTING.md,REGION_FILTER_GUIDE.md,docs/*.md,docs/*.mdx,docs/**/*.md,docs/**/*.mdx,open-docs/*.md,open-docs/*.mdx,open-docs/**/*.md,open-docs/**/*.mdx,deploy-docs/*.md,deploy-docs/*.mdx,deploy-docs/**/*.md,deploy-docs/**/*.mdx,scripts/**/*.md,src/**/README.md
GITHUB_KB_BOOTSTRAP_EXCLUDE_PATHS=
GITHUB_KB_BOOTSTRAP_POLLING_INTERVAL_SECONDS=300
GITHUB_KB_CHUNK_TARGET_TOKENS=500
GITHUB_KB_CHUNK_OVERLAP_TOKENS=60
GITHUB_KB_VECTOR_DIM=1536
GITHUB_KB_EMBEDDING_PROVIDER=mock
GITHUB_KB_EMBEDDING_API_BASE=https://api.openai.com/v1
GITHUB_KB_EMBEDDING_API_KEY=
GITHUB_KB_EMBEDDING_MODEL=text-embedding-3-small
# Example custom provider:
# GITHUB_KB_VECTOR_DIM=1024
# GITHUB_KB_EMBEDDING_PROVIDER=custom
# GITHUB_KB_EMBEDDING_API_BASE=https://api.modelarts-maas.com/v1
# GITHUB_KB_EMBEDDING_MODEL=bge-m3
GITHUB_KB_EMBEDDING_MAX_RETRIES=2
GITHUB_KB_PROFILE_SEARCH_TOPK=5
GITHUB_KB_PROFILE_AGENT_TOPK=12
GITHUB_KB_PROFILE_SEARCH_CONFIDENCE_THRESHOLD=0.6
GITHUB_KB_PROFILE_AGENT_CONFIDENCE_THRESHOLD=0.45
GITHUB_KB_POLL_BATCH_SIZE=20
GITHUB_KB_WORKER_BATCH_SIZE=20
GITHUB_KB_WORKER_INTERVAL_SECONDS=30
GITHUB_KB_ENABLE_LOCAL_DOCS_MIRROR=false
LOCAL_DOCS_COM_PATH=/tmp/__disabled_docs_com_mirror__

# Web
# Leave empty to use same-origin (/api/*), set explicit URL for local split deployment
VITE_API_BASE_URL=
VITE_AGENT_ACCESS_CODE=
